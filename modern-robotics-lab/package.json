{
  "name": "modern-robotics-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive, simulation-driven lessons for learning robot mechanics, planning and control (companion to Modern Robotics v2 by Lynch & Park).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
